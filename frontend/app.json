{
  "expo": {
    "name": "CitizenSignal",
    "slug": "citizen-signal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.citizensignal.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CitizenSignal needs your location to show nearby issues and pin your report."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CitizenSignal needs access to your photos to attach evidence to a report.",
          "cameraPermission": "CitizenSignal needs the camera to photograph the issue you are reporting."
        }
      ]
    ],
    "scheme": "citizensignal",
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "17d98f01-981c-48ab-a42e-20dea3e815ca"
      }
    },
    "owner": "sayannandi"
  }
}
